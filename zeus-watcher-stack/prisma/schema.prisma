generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Policy {
  id            String   @id @default(cuid())
  chainId       Int
  policyId      String
  contract      String
  buyer         String
  seller        String
  amount        String
  premium       String
  retryDeadline BigInt
  isActive      Boolean  @default(true)
  isPaidOut     Boolean  @default(false)
  isExpired     Boolean  @default(false)
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  votes  Vote[]
  claims Claim[]

  @@unique([chainId, policyId])
  @@index([status, retryDeadline])
}

model Vote {
  id        String   @id @default(cuid())
  policyId  String
  watcher   String
  vote      Boolean?
  signature String
  timestamp DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policy Policy @relation(fields: [policyId], references: [id])

  @@unique([policyId, watcher])
}

model Claim {
  id        String   @id @default(cuid())
  policyId  String
  txHash    String?
  gasUsed   String?
  gasPrice  String?
  status    String   @default("pending")
  error     String?
  createdAt DateTime @default(now())

  policy Policy @relation(fields: [policyId], references: [id])
}


model WatcherObservation {
  id           String   @id @default(cuid())
  chainId      Int
  policyId     String
  requestId    String
  watcher      String
  vote         Int?
  reason       String?
  signature    String?
  metadataHash String?
  nonce        Int?
  timestamp    DateTime
  createdAt    DateTime @default(now())

  @@index([requestId])
  @@index([chainId, policyId])
  @@index([watcher])
  @@index([timestamp])
}

model SellerRiskScore {
  id                    String   @id @default(cuid())
  seller                String
  chainId               Int
  riskScore             Decimal  @db.Decimal(5, 2)
  totalPolicies         Int      @default(0)
  successfulDeliveries  Int      @default(0)
  failedDeliveries      Int      @default(0)
  claimsPaid            Int      @default(0)
  claimsRejected        Int      @default(0)
  metadata              Json?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@unique([seller, chainId])
  @@index([riskScore])
  @@index([updatedAt])
}
