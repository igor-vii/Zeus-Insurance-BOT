{
  "name": "@workspace/contracts-bot",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "compile": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat compile",
    "test": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat test",
    "test:escrow": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat test test/ZeusEscrowBOT.test.ts",
    "deploy:baseSepolia": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/deploy.ts --network base-sepolia",
    "deploy:escrow-local": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/deploy-escrow-bot.ts",
    "deploy:escrow-baseSepolia": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/deploy-escrow-bot.ts --network base-sepolia",
    "deploy:escrow-mainnet": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/deploy-escrow-bot.ts --network base-mainnet",
    "deploy:insurance-baseSepolia": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/deploy-insurance-v2.ts --network base-sepolia",
    "verify": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat verify --network base-sepolia",
    "typecheck": "tsc --noEmit",
    "clean": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat clean",
    "deploy:bot-chain": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/deploy-escrow-bot.ts --network bot-chain",
    "deploy:bot-chain-testnet": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/deploy-escrow-bot.ts --network bot-chain-testnet",
    "verify:bot-chain": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat verify --network bot-chain"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "chai": "^4.2.0",
    "hardhat": "^2.22.19",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.3.0",
    "dotenv": "^16.5.0",
    "ethers": "^6.14.3"
  },
  "description": "Zeus Insurance Protocol — BOT Chain (Botanix) contracts with USDT"
}
