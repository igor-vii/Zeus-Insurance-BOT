      "bot-chain-mainnet": {
        "chainId": 677,
        "addresses": {
          "ZeusInsuranceV2": "0x8D10C2c6C92b613C1938fe532f0e391044e76188",
          "ZeusReserveV2": "0xadED902c2C6dD7D1B5b72A6a0A3358a9b9d4A79c",
          "ZeusEscrowBOT": "0x0d4AD4C6b60F445d0e478E0AF48075340AC51Cf5",
