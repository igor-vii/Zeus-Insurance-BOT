# Zeus Insurance — API Server environment variables
# For Replit: set values via Replit Secrets / Environment Variables UI.
# For local dev: copy to .env and fill in values (never commit real secrets).

# ── Network ───────────────────────────────────────────────────────────────────
# R2: default is X Layer — the canonical mainnet target (eip155:196) hosting the
# 2026-08-17 insurance/reserve/escrow generation (on-chain cross-verified).
ZEUS_NETWORK=x-layer
ZEUS_INSURANCE_NETWORK=x-layer

# Address keys are NETWORK-SUFFIXED (resolver accepts both XLAYER and X_LAYER
# spellings for x-layer). The UNSUFFIXED ZEUS_INSURANCE_ADDRESS key belongs to
# base-sepolia ONLY — it is NOT a generic fallback.

# ── Base Sepolia (testnet) — activate by switching ZEUS_NETWORK=base-sepolia ──
# ZEUS_INSURANCE_ADDRESS=0x58038Df01A824C94F3D2fEd6d4e1bEf2211Ad8F4
# ZEUS_RESERVE_ADDRESS=0xF5010Afe1856be1F447f962Dfa8AA30c2Ed19a47
# ZEUS_ESCROW_BOT_ADDRESS=0x87365462353bCBAB2CF0DF57c7Cb15519C5B7c76
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── X Layer Mainnet (OKX L2, chainId 196) — canonical generation 2026-08-17 ──
# On-chain verified 2026-10-23: Reserve.insuranceContract() == ZEUS_INSURANCE_ADDRESS_XLAYER,
# Escrow.token() == X Layer USDC (0x74b7f163…). Deploy blocks (eth_getCode history):
# Reserve 67882545, Escrow 67882552, Insurance 68135485.
ZEUS_INSURANCE_ADDRESS_XLAYER=0xed65F223d7919B24263F4d6fe74e3DA42e7fD908
ZEUS_ESCROW_ADDRESS_XLAYER=0x882c34d59E2d46a91534244e8B042e4A1fe01546
ZEUS_ESCROW_BOT_ADDRESS_XLAYER=0x882c34d59E2d46a91534244e8B042e4A1fe01546
ZEUS_RESERVE_ADDRESS_XLAYER=0xeB6A9d8b1aD63898EfC2031A5572a84a567c591c
XLAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech

# ── BOT Chain (chainId 677) — activate by switching ZEUS_NETWORK=bot-chain ────
# Insurance nextPolicyId()=1, Reserve live (on-chain verified 2026-10-23).
# ZEUS_INSURANCE_ADDRESS_BOT_CHAIN=0x2E592BEBbcC38FC3976125CB2E11312068670C45
# ZEUS_RESERVE_ADDRESS_BOT_CHAIN=0x779Fcd0344c0DCaC0F8C45E2bB5Db72D6356AE56
# ZEUS_ESCROW_BOT_ADDRESS_BOT_CHAIN=0x04DbB961817B94EE99e1eAa7cc5c07E1BD042364
# BOT_CHAIN_RPC_URL=https://rpc.botchain.ai

# ── Treasury (receives x402 fees) ────────────────────────────────────────────
# ZEUS_TREASURY=0x...

# ── Secrets (set via Replit Secrets, never store values here) ─────────────────
# SESSION_SECRET=
# SERVER_PRIVATE_KEY=
# OKLINK_API_KEY=    ← needed for X Layer contract verification on OKLink


# ── Secretariat Production Configuration (R2.0) ─────────────────────────────
# Required for Secretariat composition root (R2.1).
# See api-server/src/lib/secretariat-config.ts for full documentation.

# RPC providers — JSON array with at least 2 independent providers (§14, §15)
# ZEUS_RPC_PROVIDERS=[{"providerId":"alchemy","underlyingProvider":"alchemy","rpcUrl":"https://...","maxStalenessBlocks":10},{"providerId":"infura","underlyingProvider":"infura","rpcUrl":"https://...","maxStalenessBlocks":10}]

# x402 Facilitator service URL (required)
# ZEUS_FACILITATOR_URL=https://x402.coinbase.com
# ZEUS_FACILITATOR_API_KEY=           ← optional bearer token
# ZEUS_FACILITATOR_TIMEOUT_MS=30000   ← optional, default 30000

# Reconciliation worker tuning (optional — defaults shown)
# ZEUS_RECON_POLL_MS=5000
# ZEUS_RECON_LEASE_MS=30000
# ZEUS_RECON_ERROR_BACKOFF_MS=10000
# ZEUS_RECON_BATCH_SIZE=100

# Signer (WARNING: LOCAL_EOA is custodial dev/test only — see TRACE #8-E)
# ZEUS_SIGNER_PRIVATE_KEY=            ← set via Replit Secrets, never commit

# Sentry monitoring
SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
