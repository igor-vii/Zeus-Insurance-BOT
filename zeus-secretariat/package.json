{
  "name": "zeus-secretariat",
  "version": "0.1.0",
  "type": "module",
  "description": "Zeus Secretariat V0 - Independent execution layer with state machine, payment intent lifecycle, settlement observation, execution observation, recovery policy, and durable evidence",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/local-eoa-signer": {
      "types": "./dist/adapters/local-eoa-signer.d.ts",
      "default": "./dist/adapters/local-eoa-signer.js"
    },
    "./core/types": {
      "types": "./dist/core/types.d.ts",
      "default": "./dist/core/types.js"
    }
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:durable": "ZEUS_REQUIRE_DATABASE=1 NODE_OPTIONS=--experimental-vm-modules jest tests/durable-storage.test.ts -t \"AE: pre-intent append\"",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "echo 'No linter configured'",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zeus",
    "secretariat",
    "x402",
    "payment",
    "state-machine"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@workspace/db": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "catalog:",
    "jest": "^29.7.0",
    "pg": "^8.22.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.8.3",
    "viem": "^2.55.19"
  }
}
